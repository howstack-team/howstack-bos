<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seo.title }}</title>
  <meta name="description" content="{{ seo.description }}">
  <meta name="keywords" content="{{ seo.keywords }}">
  {% if not seo.indexable %}<meta name="robots" content="noindex,nofollow">{% endif %}
  {% if seo.canonical %}<link rel="canonical" href="{{ seo.canonical }}">{% endif %}
  {% if site.favicon %}<link rel="icon" href="{{ site.favicon }}">{% endif %}
  <link rel="stylesheet" href="{{ asset('css/main.css') }}">
  <style>:root { --primary: {{ theme.settings.primary_color }}; }</style>
</head>
<body>
  <a class="skip-link" href="#main">跳转到正文</a>
  {% include 'partials/header.html.twig' %}
  <main id="main">{% block content %}{% endblock %}</main>
  {% include 'partials/footer.html.twig' %}
  <script src="{{ asset('js/main.js') }}" defer></script>
</body>
</html>
