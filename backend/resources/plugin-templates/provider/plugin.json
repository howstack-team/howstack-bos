{
  "manifest_version": "1.0",
  "id": "magic_cloud",
  "category": "provider",
  "name": "魔方云",
  "version": "1.1.0",
  "publisher": "howstack-team",
  "license": "AGPL-3.0-or-later",
  "requires": {
    "core_min": "0.1.0",
    "core_max_exclusive": "1.0.0",
    "php_min": "8.3",
    "plugin_sdk": "1.0",
    "provider_sdk": "1.0"
  },
  "configuration_schema": "configuration.schema.json",
  "capabilities": {
    "provider.connection_test": true,
    "provider.catalog": true,
    "provider.binding_validation": true,
    "cloud_server.provision": false
  },
  "provider": {
    "type_version": "1.0.0",
    "product_types": [
      "cloud_server"
    ],
    "catalogs": [
      {
        "resource_kind": "zones",
        "kind": "areas",
        "label": "可用区"
      },
      {
        "resource_kind": "flavor_groups",
        "kind": "nodes",
        "label": "规格组"
      },
      {
        "resource_kind": "images",
        "kind": "images",
        "label": "镜像"
      },
      {
        "resource_kind": "disk_types",
        "kind": "stores",
        "label": "存储类型"
      },
      {
        "resource_kind": "lines",
        "kind": "ip_groups",
        "label": "线路"
      }
    ]
  },
  "network": {
    "base_url_field": "api_url",
    "endpoints": [
      {
        "method": "POST",
        "path": "/v1/login"
      },
      {
        "method": "GET",
        "path": "/v1/areas"
      },
      {
        "method": "GET",
        "path": "/v1/nodes"
      },
      {
        "method": "GET",
        "path": "/v1/images"
      },
      {
        "method": "GET",
        "path": "/v1/stores"
      },
      {
        "method": "GET",
        "path": "/v1/ip_groups"
      },
      {
        "method": "GET",
        "path": "/v1/image_groups"
      }
    ]
  },
  "permissions": [],
  "frontend": [],
  "migrations": [],
  "data_policy": "retain"
}
