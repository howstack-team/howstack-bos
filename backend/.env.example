APP_NAME="皓量云擎云业务运营系统"
APP_ENV=production
APP_DEBUG=false
API_DOCS_ENABLED=true
APP_KEY=
APP_INSTALLED=false
APP_URL=http://localhost
ADMIN_PATH=admin
SESSION_SECURE=false
JWT_SECRET=
JWT_TTL=7200
WEBMAN_LISTEN=http://0.0.0.0:8989
WEBMAN_COUNT=4
# 仅填写实际反向代理/CDN 的出口 IP 或 CIDR，逗号分隔；留空仅使用连接地址。
TRUSTED_PROXY_IPS=
# 可选：本地 ip2region IPv6 xdb 绝对路径；未配置时 IPv6 地点显示“未知”。
IP2REGION_IPV6_DB=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hlyq_idcbm
DB_USER=root
DB_PASSWORD=
DB_PREFIX=hlyq_

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
# 留空则按 APP_KEY 与数据库身份生成实例隔离前缀；同一实例的所有进程必须一致。
REDIS_QUEUE_PREFIX=
MESSAGE_QUEUE_WORKERS=2

# 皓量云擎账号、授权、在线更新和应用中心接入统一在 config/official_platform.php 配置。
