<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{ route('home') }}">
      <img src="{% if site.logo %}{{ site.logo }}{% else %}{{ asset('images/logo.png') }}{% endif %}" width="36" height="36" alt="">
      <span>{{ site.name }}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="展开导航">☰</button>
    <nav id="main-navigation" aria-label="主要导航">
      {% for item in navigation %}
        <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
