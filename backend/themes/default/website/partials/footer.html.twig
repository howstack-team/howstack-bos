<footer class="site-footer">
  <div class="container">
    <div class="footer-main"><a class="footer-brand" href="{{ route('home') }}">{{ site.name }}</a><div class="footer-links">
      {% for link in footer_links %}<a href="{{ link.url }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>{% endfor %}
    </div></div>
    <div class="footer-bottom"><span>{{ site.copyright }}</span><div class="records">
      {% if site.icp_record %}<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{{ site.icp_record }}</a>{% endif %}
      {% if site.public_security_record %}<span>{{ site.public_security_record }}</span>{% endif %}
    </div></div>
  </div>
</footer>
