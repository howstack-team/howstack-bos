{
  "schema_version": "1.0",
  "scope": "connection",
  "fields": [
    {
      "key": "access_key_id",
      "label": "SecretId",
      "type": "text",
      "required": true,
      "placeholder": "请输入SecretId",
      "max_length": 128
    },
    {
      "key": "access_key_secret",
      "label": "SecretKey",
      "type": "password",
      "required": true,
      "placeholder": "请输入SecretKey",
      "max_length": 128
    },
    {
      "key": "region",
      "label": "地域",
      "type": "text",
      "required": true,
      "placeholder": "请输入地域",
      "max_length": 128,
      "default": "ap-guangzhou"
    },
    {
      "key": "bucket",
      "label": "存储桶",
      "type": "text",
      "required": true,
      "placeholder": "请输入存储桶",
      "max_length": 128,
      "description": "完整存储桶名称，包含 APPID 后缀，例如 example-1250000000。"
    }
  ]
}
