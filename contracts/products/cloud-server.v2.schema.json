          "minimum": 1,
          "maximum": 4294967295
        },
        "zone_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "line_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "flavor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "image_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "flavor_group_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "image_type_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "protection_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "billing_mode": {
          "const": "prepaid"
        },
        "login_method": {
          "const": "password"
        },
        "duration_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "system_disk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "size_gib": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          }
        },
        "data_disks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "size_gib": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              }
            },
            "required": [
              "type_id",
              "size_gib"
            ]
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "billing_mode": {
              "const": "fixed"
            },
            "egress_mbps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "ingress_mbps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "ipv4_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        }
      }
    },
    "providerParameterRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "enum": [
            "region.external_id",
            "zone.external_id",
            "line.external_id",
            "flavor_group.external_id",
            "flavor.external_id",
            "flavor.cpu",
            "flavor.memory_mib",
            "flavor.architecture",
            "image.external_id",
            "image.default_username",
            "image.default_port",
            "system_disk.type.external_id",
            "system_disk.size_gib",
            "data_disks",
            "network.egress_mbps",
            "network.ingress_mbps",
            "network.ipv4_count",
            "protection.external_id",
            "quantity",
            "duration.count",
            "duration.unit",
            "login_method"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "transform": {
          "enum": [
            "copy",
            "string",
            "multiply",
            "divide",
            "lookup"
          ]
        },
        "factor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "lookup": {
          "type": [
            "object",
            "array"
          ],
          "maxProperties": 200,
          "maxItems": 200,
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "durationOptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "discount_kind": {
            "enum": [
              "rate",
              "billed_months"
            ]
          },
          "rate_bps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "billed_months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        },
        "required": [
          "months",
          "label",
          "discount_kind"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "discount_kind": {
                  "const": "rate"
                }
              }
            },
            "then": {
              "required": [
                "rate_bps"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "discount_kind": {
                  "const": "billed_months"
                }
              }
            },
            "then": {
              "required": [
                "billed_months"
              ]
            }
          }
        ]
      }
    }
  }
}
