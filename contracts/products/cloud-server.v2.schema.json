{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:howstack:products:cloud-server:2.0.0",
  "title": "云服务器预付费销售契约 v2",
  "description": "v2按可用区独立设置月数周期与优惠，网络配置归属于线路并随销售版本封存；缺省可用区周期的旧配置按原全局规则兼容，不重写历史版本。本契约不开放按量、流量或密钥登录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "code",
    "description",
    "revision",
    "draft"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "draft": {
      "$ref": "#/$defs/draft"
    }
  },
  "$defs": {
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "month": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      },
      "required": []
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regions": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "zones": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "lines": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "flavor_groups": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "flavors": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "image_types": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "images": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "disk_types": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "protections": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            }
          },
          "required": [
            "regions",
            "zones",
            "lines",
            "flavor_groups",
            "flavors",
            "image_types",
            "images",
            "disk_types",
            "protections"
          ]
        },
        "cycles": {
          "const": [
            "month"
          ]
        },
        "quantity_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "setup_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "provider_connection_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "price_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flavors": {
              "type": "object",
              "patternProperties": {
                "^[1-9][0-9]*$": {
                  "$ref": "#/$defs/prices"
                }
              },
              "additionalProperties": false,
              "maxProperties": 500
            },
            "disk_types": {
              "type": "object",
              "patternProperties": {
                "^[1-9][0-9]*$": {
                  "$ref": "#/$defs/prices"
                }
              },
              "additionalProperties": false,
              "maxProperties": 500
            },
            "protections": {
              "type": "object",
              "patternProperties": {
                "^[1-9][0-9]*$": {
                  "$ref": "#/$defs/prices"
                }
              },
              "additionalProperties": false,
              "maxProperties": 500
            }
          },
          "required": []
        },
        "trial_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 720
            },
            "limit_per_member": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "enabled",
            "hours",
            "limit_per_member"
          ]
        },
        "refund_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "window_hours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8760
            },
            "prorated": {
              "type": "boolean"
            },
            "keep_setup_fee": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "window_hours",
            "prorated",
            "keep_setup_fee"
          ]
        },
        "renewal_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pricing": {
              "const": "current"
            },
            "auto_renew_enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "pricing",
            "auto_renew_enabled"
          ]
        },
        "delivery_rule_id": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "system_disk_included_gib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536,
          "default": 0,
          "description": "每台实例、每个所选预付费周期的系统盘赠送容量（GiB）；计费容量为 max(0, 实际容量 - 赠送容量)，不抵扣数据盘，不改变完整交付容量。缺省为 0。"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "billing_mode": {
          "const": "prepaid"
        },
        "durations": {
          "$ref": "#/$defs/durationOptions",
          "description": "仅兼容未设置 zone_durations 的历史全局周期；显式按可用区设置时不使用此字段。"
        },
        "storage_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_type_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "default_size_gib": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "max_data_disks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          },
          "required": [
            "default_type_id",
            "default_size_gib",
            "max_data_disks"
          ]
        },
        "trial_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zone_ids": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "flavor_ids": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "line_ids": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "image_ids": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "max_system_disk_gib": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "max_data_disks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "max_egress_mbps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max_ingress_mbps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max_ip_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "cooldown_hours": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8760
            },
            "concurrent_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "disk_type_ids": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "protection_ids": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "max_data_disk_gib": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "required": [
            "zone_ids",
            "flavor_ids",
            "line_ids",
            "image_ids",
            "max_system_disk_gib",
            "max_data_disks",
            "max_egress_mbps",
            "max_ingress_mbps",
            "max_ip_count",
            "cooldown_hours",
            "concurrent_limit"
          ]
        },
        "zone_provider_bindings": {
          "type": "array",
          "maxItems": 500,
          "description": "按可用区配置提供者；发布要求覆盖可售可用区，未指定项保留历史单连接或交付规则语义。不保存凭据。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zone_id",
              "connection_id"
            ],
            "properties": {
              "zone_id": {
                "type": "integer",
                "minimum": 1
              },
              "connection_id": {
                "type": "integer",
                "minimum": 0
              },
              "parameter_mapping": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/$defs/providerParameterRule"
                }
              }
            }
          }
        },
        "zone_durations": {
          "type": "array",
          "maxItems": 500,
          "description": "按参与购买的可用区分别设置周期及优惠；同一可用区仅一组，同组月数不能重复。保存可不完整，发布必须覆盖全部参与购买的可用区；显式配置不得回退全局周期。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zone_id",
              "durations"
            ],
            "properties": {
              "zone_id": {
                "type": "integer",
                "minimum": 1
              },
              "durations": {
                "$ref": "#/$defs/durationOptions"
              }
            }
          }
        }
      },
      "required": [
        "resource_ids",
        "cycles",
        "quantity_limit",
        "setup_minor",
        "provider_connection_id",
        "price_overrides",
        "trial_policy",
        "refund_policy",
        "renewal_policy",
        "schema_version",
        "storage_policy",
        "trial_scope"
      ],
      "anyOf": [
        {
          "required": [
            "zone_durations"
          ]
        },
        {
          "required": [
            "durations"
          ]
        }
      ]
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "size_gib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "type_id",
        "size_gib"
      ]
    },
    "purchase_configuration": {
      "$ref": "#/$defs/selection"
    },
    "lineNetwork": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "billing_mode": {
          "const": "fixed"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "default": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "included": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "price_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "pricing_mode": {
              "enum": [
                "flat",
                "graduated",
                "volume"
              ]
            },
            "tiers": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "up_to_mbps": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "price_minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  }
                },
                "required": [
                  "up_to_mbps",
                  "price_minor"
                ]
              }
            }
          },
          "required": [
            "min",
            "max",
            "step",
            "default",
            "included",
            "price_minor",
            "pricing_mode",
            "tiers"
          ]
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "default": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "included": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "price_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "pricing_mode": {
              "enum": [
                "flat",
                "graduated",
                "volume"
              ]
            },
            "tiers": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "up_to_mbps": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "price_minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  }
                },
                "required": [
                  "up_to_mbps",
                  "price_minor"
                ]
              }
            }
          },
          "required": [
            "min",
            "max",
            "step",
            "default",
            "included",
            "price_minor",
            "pricing_mode",
            "tiers"
          ]
        },
        "ip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "range",
                "options"
              ]
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "default": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "included": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "price_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "options": {
              "type": "array",
              "maxItems": 65,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              }
            }
          },
          "required": [
            "mode",
            "min",
            "max",
            "step",
            "default",
            "included",
            "price_minor",
            "options"
          ]
        }
      },
      "required": [
        "billing_mode",
        "egress",
        "ingress",
        "ip"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "zone_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "line_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "flavor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "image_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "flavor_group_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "image_type_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "protection_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "billing_mode": {
          "const": "prepaid"
        },
        "login_method": {
          "const": "password"
        },
        "duration_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "system_disk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "size_gib": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          },
          "required": [
            "type_id",
            "size_gib"
          ]
        },
        "data_disks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "size_gib": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              }
            },
            "required": [
              "type_id",
              "size_gib"
            ]
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "billing_mode": {
              "const": "fixed"
            },
            "egress_mbps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "ingress_mbps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "ipv4_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          },
          "required": [
            "egress_mbps",
            "ingress_mbps",
            "ipv4_count"
          ]
        }
      },
      "required": [
        "region_id",
        "zone_id",
        "line_id",
        "flavor_id",
        "image_id",
        "duration_months",
        "system_disk",
        "network"
      ]
    },
    "partialSelection": {
      "type": "object",
