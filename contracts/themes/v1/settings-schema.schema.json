{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": [
        "object",
        "array",
        "string",
        "integer",
        "number",
        "boolean"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#"
      }
    },
    "required": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "additionalProperties": {
      "const": false
    },
    "items": {
      "$ref": "#"
    },
    "minItems": {
      "type": "integer",
      "minimum": 0
    },
    "maxItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "minLength": {
      "type": "integer",
      "minimum": 0
    },
    "maxLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "minimum": {
      "type": "number"
    },
    "maximum": {
      "type": "number"
    },
    "enum": {
      "type": "array",
      "maxItems": 100,
      "minItems": 1
    },
    "pattern": {
      "type": "string",
      "maxLength": 200
    },
    "format": {
      "enum": [
        "color",
        "image-id"
      ]
    },
    "x-widget": {
      "enum": [
        "input",
        "textarea",
        "image",
        "color",
        "select",
        "switch",
        "number",
        "list"
      ]
    },
    "default": {
      "description": "字段或对象的初始值，必须符合当前节点的配置规则"
    }
  },
  "required": [
    "type"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "object"
          }
        }
      },
      "then": {
        "required": [
          "properties",
          "additionalProperties"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "array"
          }
        }
      },
      "then": {
        "required": [
          "items",
          "maxItems"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "string"
          }
        }
      },
      "then": {
        "required": [
          "maxLength"
        ]
      }
    }
  ]
}
