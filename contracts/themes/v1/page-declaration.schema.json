{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howstack.local/contracts/themes/v1/page-declaration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^/[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*){0,5}$"
    },
    "template": {
      "type": "string",
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "indexable": {
          "type": "boolean"
        },
        "keywords": {
          "type": "string",
          "maxLength": 255
        }
      }
    }
  },
  "required": [
    "path",
    "template",
    "title"
  ]
}
